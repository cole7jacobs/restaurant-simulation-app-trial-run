{
  "name": "restaurant-simulation-app-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "tsconfig": "tsconfig.worker.json",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "restaurant-simulation-app-staging-db",
    "database_id": "4065b70e-8834-4e0f-8f51-c7bc0a82b710",
    "migrations_dir": "./db/migrations"
  }]
}
