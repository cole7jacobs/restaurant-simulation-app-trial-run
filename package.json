{
  "name": "restaurant-simulation-app",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "ISDS 4125 Restaurant Simulation App — web interface for the FORTRAN restaurant management simulation",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --local --port 8787",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file db/seed.dev.sql",
    "db:init": "npm run db:migrate && npm run db:seed",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "type-check": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "miniflare": "3.20250718.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.6",
    "wrangler": "^3.95.0"
  }
}
