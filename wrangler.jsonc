{
  // Cloudflare Worker configuration for the Restaurant Simulation App
  // Docs: https://developers.cloudflare.com/workers/

  "name": "restaurant-simulation-app",

  // Worker entry point (Hono application)
  "main": "worker/index.ts",

  // Minimum compatibility date — set to a stable date that supports Static Assets
  "compatibility_date": "2025-04-01",

  // TypeScript config for the Worker (uses Cloudflare Workers types, not DOM)
  "tsconfig": "tsconfig.worker.json",

  // Static Assets: serves the Vite build output (dist/) as a Cloudflare static site.
  // - `binding` exposes the asset fetcher to the Worker as `env.ASSETS`
  // - `not_found_handling: "single-page-application"` serves index.html for
  //   any path that does not match a file, enabling client-side React Router routing.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // Placeholder ID for local D1. A real Cloudflare database must be configured separately.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restaurant-simulation-db",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "./db/migrations"
    }
  ]
}
